    "from sklearn.preprocessing import MinMaxScaler, StandardScaler\n",
    "\n",
    "def cluster_level_gene_importance(adata, trans_in_dict_local, trans_in_dict_global, attn_matrix_dict):\n",
    "    results = []\n",
    "    H_GNN_all, H_T_all, cell_index = [], [], []\n",
    "    for key in trans_in_dict_local.keys():\n",
    "        scaler = StandardScaler()\n",
    "        H_GNN = trans_in_dict_local[key].detach().numpy().squeeze(1)\n",
    "        H_T = trans_in_dict_global[key].detach().numpy().squeeze(1)[1:, :]\n",
    "        H_GNN_all.extend(scaler.fit_transform(H_GNN))\n",
    "        H_T_all.extend(scaler.fit_transform(H_T))\n",
    "        # H_GNN_all.extend(trans_in_dict_local[key].detach().numpy().squeeze(1))\n",
    "        # H_T_all.extend(trans_in_dict_global[key].detach().numpy().squeeze(1)[1:, :])\n",
    "        cell_index.extend(attn_matrix_dict[key].index.intersection(adata.obs_names))\n",
    "    H_GNN_all = np.array(H_GNN_all)\n",
    "    H_T_all = np.array(H_T_all)\n",
    "    print(f'Shape of local ({H_GNN_all.shape}) and global embeddings ({H_T_all.shape}).')\n",
    "    leiden_gnn, leiden_trans = umap_embeddings(H_GNN_all, H_T_all, leiden_res = 0.05)\n",
    "    #TODO if adata bigger than sliding_window size then subsample\n",
    "    adata = adata[adata.obs_names.isin(cell_index)]\n",
    "    adata.obs['leiden_local'] = leiden_gnn\n",
    "    adata.obs['leiden_global'] = leiden_trans\n",
    "    #adata.X = adata.layers['log1p_norm']\n",
    "    sc.tl.rank_genes_groups(adata, groupby='leiden_local', method='wilcoxon', key_added = 'dge_wilcoxon_local')\n",
    "    sc.tl.rank_genes_groups(adata, groupby='leiden_global', method='wilcoxon', key_added = 'dge_wilcoxon_global')\n",
    "    return adata"
   ]
  },
