   "source": [
    "def paired_cluster_comparison(adata, cluster_1: int, cluster_2: int, dge_key_cluster1: str, dge_key_cluster2: str, LOGFC_THRESHOLD: float = 0.05, NR_TOP_GENES: int = 7):\n",
    "    \"\"\" Compare the DGE driving two clusters.\n",
    "    \"\"\"\n",
    "    cluster_str_1, cluster_str_2 = str(cluster_1), str(cluster_2)\n",
    "    \n",
    "    df_1 = sc.get.rank_genes_groups_df(adata, cluster_str_1, key=dge_key_cluster1)\n",
    "    df_2 = sc.get.rank_genes_groups_df(adata, cluster_str_2, key=dge_key_cluster2)\n",
    "\n",
    "    df_1 = df_1.rename(columns=lambda x: f\"{x}_1\")\n",
    "    df_2 = df_2.rename(columns=lambda x: f\"{x}_2\")\n",
    "    merged_df = pd.merge(df_1, df_2, left_on=\"names_1\", right_on=\"names_2\")\n",
    "\n",
    "    merged_df = merged_df[\n",
    "        (merged_df[\"pvals_adj_1\"] <= 0.05) | (merged_df[\"pvals_adj_2\"] <= 0.05)\n",
    "    ]\n",
    "    \n",
    "    filtered_genes = merged_df[\n",
    "        ((merged_df['logfoldchanges_1'] > LOGFC_THRESHOLD) & (merged_df['logfoldchanges_2'] < -LOGFC_THRESHOLD)) |\n",
    "        ((merged_df['logfoldchanges_1'] < -LOGFC_THRESHOLD) & (merged_df['logfoldchanges_2'] > LOGFC_THRESHOLD))\n",
    "    ]\n",
    "    \n",
    "    filtered_genes[\"log2FC_1_2\"] = (\n",
    "        filtered_genes['logfoldchanges_2'].abs() + filtered_genes['logfoldchanges_1'].abs()\n",
    "    )\n",
    "\n",
    "    top_genes = filtered_genes.sort_values(by=\"log2FC_1_2\", ascending=False).head(NR_TOP_GENES)\n",
    "    print(top_genes)\n",
    "    \n",
    "    # Highlight the top genes in the scatter plot\n",
    "    plt.figure(figsize=(8, 6))\n",
    "    \n",
    "    # Add a new column to `merged_df` indicating if a gene is among the top genes\n",
    "    merged_df['is_top_gene'] = merged_df['names_1'].isin(top_genes['names_1'])\n",
    "    \n",
    "    # Scatter plot for all genes\n",
    "    sns.scatterplot(\n",
    "        x=\"logfoldchanges_1\",\n",
    "        y=\"logfoldchanges_2\",\n",
    "        data=merged_df,\n",
    "        hue=\"is_top_gene\",  # Color by whether the gene is a top gene\n",
    "        palette={True: \"red\", False: \"gray\"},  # Red for top genes, gray for others\n",
    "        alpha=0.8,\n",
    "        s=20  # Adjust marker size\n",
    "    )\n",
    "    \n",
    "    # Annotate top genes on the scatter plot\n",
    "    for _, row in top_genes.iterrows():\n",
    "        plt.text(\n",
    "            row[\"logfoldchanges_1\"],\n",
    "            row[\"logfoldchanges_2\"],\n",
    "            row[\"names_1\"],  # Gene name\n",
    "            fontsize=6,\n",
    "            color=\"blue\",\n",
    "            weight=\"bold\"\n",
    "    )\n",
    "    \n",
    "    # Add title and axis labels\n",
    "    plt.title(f\"Log2 Fold Change Comparison for Cluster {cluster_str_1} vs {cluster_str_2}\")\n",
    "    plt.xlabel(\"Log2 Fold Change (1)\")\n",
    "    plt.ylabel(\"Log2 Fold Change (2)\")\n",
    "    \n",
    "    # Add reference lines\n",
    "    plt.axhline(0, color=\"black\", linestyle=\"--\", linewidth=0.7)\n",
    "    plt.axhline(-0.5, color=\"red\", linestyle=\"--\", linewidth=1.2)\n",
    "    plt.axhline(0.5, color=\"red\", linestyle=\"--\", linewidth=1.2)\n",
    "    plt.axvline(0, color=\"black\", linestyle=\"--\", linewidth=0.7)\n",
    "    plt.axvline(-0.5, color=\"red\", linestyle=\"--\", linewidth=1.2)\n",
    "    plt.axvline(0.5, color=\"red\", linestyle=\"--\", linewidth=1.2)\n",
    "    \n",
    "    # Adjust layout and grid\n",
    "    plt.grid(True, alpha=0.5)\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
